label = paste0("Min θ (vulnerable) = ", round(min_positive_theta, 2)),
hjust = 1.1, vjust = -0.5, color = "firebrick", size = 3) +
annotate("text", x = Inf, y = max_negative_theta,
label = paste0("Max θ (resilient) = ", round(max_negative_theta, 2)),
