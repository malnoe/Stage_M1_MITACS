df_LORA_grouping_pss$pss_sum
# Calcul des coefficients de la droite des moindres carrés
reg <- lm(data=df_LORA_grouping_pss, ghq_sum ~ pss_sum)
beta0.hat <- reg$coefficients[1]
beta1.hat <- reg$coefficients[2]
