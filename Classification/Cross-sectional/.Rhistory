) +
scale_x_continuous(limits = c(0, 200)) +
scale_y_continuous(limits = c(0, 0.1)) +
labs(x = "Indice des p-valeurs ordonnées", y = "P-valeur")+
theme_light()+
theme(
plot.title = element_text(size = 10),
axis.title = element_text(size = 10, face = "bold"),
axis.text = element_text(size = 6),
panel.border = element_blank(),
axis.line = element_line(colour = "grey2"),
panel.grid.minor = element_blank(),
panel.grid.major = element_line(color = "grey85"),
legend.title = element_text(size = 10, face = "bold"),
legend.text = element_text(size = 8),
legend.position = "right",
)
# Grille des lambdas
Lambda <- seq(.05, .95, .05)
# Evaluation de pi0.hat.prime
pi0.hat.prime <- min(sapply(Lambda, function(l) pi0_func(l, pval)))
# Boostrap
## Nombre de répétitions
B <- 1000
## Matrice pour stocker pi0.hat.star.b avec B lignes et Lambda colonnes
pi0.star <- matrix(nrow = B, ncol = length(Lambda))
## Vecteur pour sauvegarder les valeurs du MSE pour chaque valeur de lambda
mse <- numeric(length(Lambda))
for (b in 1:B) {
# Echantillon bootstrappé des p-valeurs
pval_star <- sample(pval, size=length(pval), replace=TRUE)
# Pour tous les lambdas on calcule pi0.hat et on remplit pi0.star
pi0.star[b, ] <- sapply(Lambda, function(l) pi0_func(l, pval_star))
}
# Pour chaque valeur de lambda, on calcule son MSE
for (index_lambda in 1:length(Lambda)) {
mse[index_lambda] <- mean((pi0.star[, index_lambda] - pi0.hat.prime)^2)
}
# Calcule de lambda.hat = argming sur Lambda de MSE(lambda)
minMSE <- min(mse)
index <- which(mse==minMSE)
lambda.hat <- Lambda[min(index)]
# Cacul du pi0.hat correspondant
pi0_hat <- pi0_func(lambda.hat, pval)
pi0_hat
# Calcul du m0_hat
m0_hat <- length(pval) * pi0_hat
m0_hat
alpha <- .05
# Procédure de Bonferonni
bonf <- sum(pval_bonf <= alpha)
# Procédure de Holm
holm <- 1
while (holm <= m & pval_holm[holm] <= alpha) {
holm <- holm + 1
}
# Procédure de BH
BH <- m
while (BH > 0 & pval_bh[BH] > alpha) {
BH <- BH - 1
}
# Procédure de BY
BY <- m
while (BY > 0 & pval_by[BY] > alpha) {
BY <- BY - 1
}
# Procédure de Bonferonni améliorée
bonf_tilde <- sum(pval_sort <= alpha/m0_hat)
# Procédure de BH améliorée
bh_tilde <- m
while (bh_tilde > 0 & pval_sort[bh_tilde] > alpha*bh_tilde / m0_hat) {
bh_tilde <- bh_tilde - 1
}
# Procédure de BY améliorée
Sm <- sum(1/(1:m))
by_tilde <- m
while (by_tilde > 0 & pval_sort[by_tilde] > alpha*by_tilde / (m0_hat*Sm)) {
by_tilde <- by_tilde - 1
}
procedures <- c(
"Bonferroni", "Holm", "BH", "BY",
"Bonferroni améliorée", "BH améliorée", "BY améliorée"
)
nb_genes <- c(bonf, holm, BY, BY, bonf_tilde, bh_tilde, by_tilde)
ratio <- round(nb_genes / m * 100, 2)
res_ratio <- data.frame(proc = procedures, genes = nb_genes, ratio = ratio)
colnames(res_ratio) <- c("Procédures", "Nombre de paires de ROIs corrélées", "Ratio (%)")
res_ratio
m <- length(pval)
data <- data.frame(
x = 1:m, pval_bonf = pval_bonf, pval_holm = pval_holm,
pval_bh = pval_bh, pval_by = pval_by
)
ggplot(data = data, aes(x = x)) +
geom_line(aes(y = pval_bonf, col = "Bonferroni"),size=1) +
geom_line(aes(y = pval_holm, col = "Holm"),size=1) +
geom_line(aes(y = pval_bh, col = "BH"),size=1) +
geom_line(aes(y = pval_by, col = "BY"),size=1) +
geom_hline(yintercept = 0.05) +
scale_color_manual(
name = "Procédure",
values = c("Bonferroni" = 1, "Holm" = 2, "BH" = 4, "BY" = 5)
) +
scale_x_continuous(limits = c(0, 200)) +
scale_y_continuous(limits = c(0, 0.1)) +
labs(x = "Indice des p-valeurs ordonnées", y = "P-valeur")+
theme(
plot.title = element_text(size = 10),
axis.title = element_text(size = 10, face = "bold"),
axis.text = element_text(size = 6),
panel.border = element_blank(),
axis.line = element_line(colour = "grey2"),
panel.grid.minor = element_blank(),
panel.grid.major = element_line(color = "white"),
legend.title = element_text(size = 10, face = "bold"),
legend.text = element_text(size = 8),
legend.position = "right",
)
sim=function(rho,m,mu){
w=rnorm(1)
xi=rnorm(m)
x=mu + sqrt(rho)*w + sqrt(1-rho)*xi
pval=1-pnorm(x)
return(pval)
}
# Fonction générale de calcul du FWE et du FDP pour des p-valeurs
err <- function(pv,mu){
indices_H0 <- which(mu==0)
pv0 <- pv[indices_H0]
V <- sum(pv0<alpha)
R <- sum(pv<alpha)
FWE <- as.numeric(V>=1)
FDP <- ifelse(R==0,0,V/R)
return(c(FWE=FWE,FDP=FDP))
}
# Fonction de calcul avec les p-valeurs corrigées de Bonferroni, Holm, Hochberg, BH et BY
do.err=function(pv,mu){
M=rbind(err(p.adjust(pv,method="bonferroni"),mu),
err(p.adjust(pv,method="holm"),mu),
err(p.adjust(pv,method="hochberg"),mu),
err(p.adjust(pv,method="BH"),mu),
err(p.adjust(pv,method="BY"),mu))
rownames(M)=c('Bonferroni','Holm','Hochberg','BH','BY')
return(M)
}
# Paramètres
# Nombre de tests
m <- 100
# Proportion de tests sour H0
pi_0 <- 0.8
# Vecteur mu
mu <- c(rep(0,m*pi_0),rep(4,m*(1-pi_0)))
# Equicorrélation
rho <- 0
# Seuil
alpha <- 0.05
# Reproductibilité
set.seed(1)
# Evaluation de l'erreur
do.err(sim(rho,m,mu),mu)
# Reproductibilité
set.seed(1)
# Valeur assez grande pour avoir une bonne estimation
B <- 5000
res <- replicate(B,do.err(sim(rho,m,mu),mu))
fwe <- res[,1,]
fdp <- res[,2,]
fwer <- apply(fwe,1,mean)
fdr <- apply(fdp,1,mean)
round(rbind(fwer,fdr),4)
B <- 1000
# Resultats
set.seed(3)
rho_vals <- seq(from=0,to=1,by=0.025)
results_rho <- map_dfr(rho_vals,function(rho_var){
res <- replicate(B, do.err(sim(rho_var,m,mu),mu))
fwe<-res[,1,]
fdp<-res[,2,]
fwer<-apply(fwe,1,mean)
fdr<-apply(fdp,1,mean)
tibble(rho=rho_var,procédure=names(fwer),FWER=fwer,FDR=fdr)
})
# Plot FDR
plot_fdr <- ggplot(results_rho,aes(x=rho, y=FDR, color=procédure))+
geom_line(size=1)+
geom_point()+
ylim(0,0.05)+
labs(
title = "Impact de l'équicorrélation rho sur le FDR",
x= expression(rho),
y="FDR",
color="Procédure de correction"
)+
theme_light() +
theme(
plot.title = element_text(size = 10),
axis.title = element_text(size = 10, face = "bold"),
axis.text = element_text(size = 6),
panel.border = element_blank(),
axis.line = element_line(colour = "grey2"),
panel.grid.minor = element_blank(),
panel.grid.major = element_line(color = "grey85"),
legend.title = element_text(size = 10, face = "bold"),
legend.text = element_text(size = 8),
legend.position = "right",
)
# Plot FWER
plot_fwer <- ggplot(results_rho,aes(x=rho,y=FWER,color=procédure))+
geom_line(size=1)+
geom_point()+
labs(
title = "Impact de l'équicorrélation rho sur le FWER",
x= expression(rho),
y="FWER",
color="Procédure de correction"
)+
theme_light() +
theme(
plot.title = element_text(size = 10),
axis.title = element_text(size = 10, face = "bold"),
axis.text = element_text(size = 6),
panel.border = element_blank(),
axis.line = element_line(colour = "grey2"),
panel.grid.minor = element_blank(),
panel.grid.major = element_line(color = "grey85"),
legend.title = element_text(size = 10, face = "bold"),
legend.text = element_text(size = 8),
legend.position = "right",
)
ggarrange(plot_fdr, plot_fwer,
ncol = 1, nrow = 2, common.legend = TRUE, legend = "bottom")
