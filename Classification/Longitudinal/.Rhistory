fsozu <- paste0("fsozu_",1:14)
gpass <- paste0("gpass_",c(1,2,6,8,10:14,16:18,20,26,27))
pas_content <- paste0("pass_content", 1:14)
gse <- paste0("gse_",1:10)
ielc <- paste0("ielc_",1:28)
le <- paste0("le_",1:27)
lotr <- paste0("lotr_",1:10)
