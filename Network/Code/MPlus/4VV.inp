TITLE: LPA Class : 4 / Variance : Vary / Covariances : Vary

DATA:
  FILE = LORAr.dat;

VARIABLE:
  NAMES = PAS_cont PAS_proc;
  USEVARIABLES = PAS_cont PAS_proc;
  CLASSES = c(4);

ANALYSIS:
  TYPE = MIXTURE;
  STARTS = 500 100;
  STITERATIONS = 100;

MODEL:
  %c#1%
    PAS_cont*;
    PAS_proc*;
    PAS_cont WITH PAS_proc;

  %c#2%
    PAS_cont*;
    PAS_proc*;
    PAS_cont WITH PAS_proc;

OUTPUT:
  TECH11 TECH14;
