INPUT INSTRUCTIONS

  TITLE: LPA Class : 2 / Variance : Vary / Covariances : Vary

  DATA:
    FILE = LORAr.dat;

  VARIABLE:
    NAMES = PAS_cont PAS_proc;
    USEVARIABLES = PAS_cont PAS_proc;
    CLASSES = c(2);

  ANALYSIS:
    TYPE = MIXTURE;
    STARTS = 500 50;
    STITERATIONS = 50;

  MODEL:
    %c#1%
      PAS_cont*;
      PAS_proc*;
      PAS_cont WITH PAS_proc;

    %c#2%
      PAS_cont*;
      PAS_proc*;
      PAS_cont WITH PAS_proc;

  OUTPUT:
    TECH11 TECH14;



*** WARNING in MODEL command
  All variables are uncorrelated with all other variables within class.
  Check that this is what is intended.
